name: rvs
arch: __ARCH__
platform: linux
version: __VERSION__
section: devel
priority: optional
maintainer: Ravenstash <support@ravenstash.com>
description: Ravenstash developer CLI.
vendor: Ravenstash
homepage: https://ravenstash.com
license: Proprietary
depends:
  - ca-certificates
contents:
  - src: dist/pyinstaller/rvs
    dst: /usr/lib/rvs
    type: tree
  - src: /usr/lib/rvs/rvs
    dst: /usr/bin/rvs
    type: symlink
  - src: README.md
    dst: /usr/share/doc/rvs/README.md
